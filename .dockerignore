# Keep the build context small. Without this the daemon uploads .venv,
# node_modules and .git — hundreds of MB that the image never uses.

.git
.gitignore
.venv
venv
__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
*.egg-info

frontend/node_modules
frontend/.next
frontend/out

# Logs are a runtime volume, never baked into the image.
server/logs

# Credentials never enter the image; supply them at run time.
.env
.env.*

.claude
.vscode
.idea
.DS_Store
Dockerfile
docker-compose.yml
.dockerignore
